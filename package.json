{
  "name": "game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run verify && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:startup": "node scripts/check-startup.mjs",
    "test:persistence": "node scripts/check-persistence.mjs",
    "test": "pnpm run test:startup && pnpm run test:persistence && pnpm run test:errors && pnpm run test:interactions && pnpm run test:identity && pnpm run test:projections && pnpm run test:dataviz && pnpm run test:mirror && pnpm run test:canvas && pnpm run test:mirror-canvas && pnpm run test:media-music && pnpm run test:enrichment && pnpm run test:health && pnpm run test:graph && pnpm run test:finish && pnpm run test:render",
    "verify": "pnpm run typecheck && pnpm run test",
    "test:errors": "node scripts/check-errors.mjs",
    "test:interactions": "node scripts/check-interactions.mjs",
    "test:health": "node scripts/check-health.mjs",
    "test:graph": "node scripts/check-graph.mjs",
    "test:identity": "node scripts/check-identity.mjs",
    "test:projections": "node scripts/check-projections.mjs",
    "test:dataviz": "node scripts/check-dataviz.mjs",
    "test:mirror": "node scripts/check-mirror.mjs",
    "test:canvas": "node scripts/check-canvas.mjs",
    "test:mirror-canvas": "node scripts/check-mirror-canvas.mjs",
    "test:media-music": "node scripts/check-media-music.mjs",
    "test:enrichment": "node scripts/check-enrichment.mjs",
    "test:finish": "node scripts/check-finish.mjs",
    "test:render": "node scripts/check-render.mjs"
  },
  "dependencies": {
    "@react-spring/three": "^9.7.5",
    "@react-three/csg": "^3.2.0",
    "@react-three/drei": "^9.114.3",
    "@react-three/fiber": "^8.17.10",
    "@react-three/postprocessing": "^2.16.3",
    "gsap": "^3.12.5",
    "leva": "^0.9.35",
    "maath": "^0.10.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.171.0",
    "three-custom-shader-material": "^6.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "jsdom": "^30.0.1",
    "typescript": "~5.6.3",
    "vite": "^6.0.3"
  }
}
